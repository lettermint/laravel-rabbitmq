{
    "name": "lettermint/laravel-rabbitmq",
    "description": "A RabbitMQ queue driver for Laravel with explicit topology, publisher confirms, delayed releases, and dead-letter tools",
    "keywords": ["laravel", "rabbitmq", "queue", "amqp", "messaging", "dead-letter", "dlq"],
    "license": "MIT",
    "homepage": "https://github.com/lettermint/laravel-rabbitmq",
    "support": {
        "issues": "https://github.com/lettermint/laravel-rabbitmq/issues",
        "source": "https://github.com/lettermint/laravel-rabbitmq"
    },
    "authors": [
        {
            "name": "Bjarn Bronsveld",
            "email": "bjarn@lettermint.co",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-sockets": "*",
        "illuminate/contracts": "^11.0 | ^12.0 | ^13.0",
        "illuminate/queue": "^11.0 | ^12.0 | ^13.0",
        "illuminate/support": "^11.0 | ^12.0 | ^13.0",
        "php-amqplib/php-amqplib": "^3.6"
    },
    "suggest": {
        "ext-pcntl": "Required for Laravel job timeouts and graceful worker signals",
        "ext-posix": "Required for heartbeats while a job is running",
        "filament/filament": "Required for the optional RabbitMQ dead-letter page"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "mockery/mockery": "^1.6.10",
        "filament/filament": "^5.0",
        "nunomaduro/collision": "^8.1.1 | ^9.0",
        "larastan/larastan": "^2.9||^3.0",
        "orchestra/testbench": "^9.9 | ^10.0 | ^11.0",
        "pestphp/pest": "^3.7 | ^4.0",
        "pestphp/pest-plugin-arch": "^3.0 | ^4.0",
        "pestphp/pest-plugin-laravel": "^3.1 | ^4.0",
        "phpstan/extension-installer": "^1.3||^2.0",
        "phpstan/phpstan-deprecation-rules": "^1.1||^2.0",
        "phpstan/phpstan-phpunit": "^1.3||^2.0"
    },
    "autoload": {
        "psr-4": {
            "Lettermint\\RabbitMQ\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lettermint\\RabbitMQ\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lettermint\\RabbitMQ\\RabbitMQServiceProvider"
            ],
            "aliases": {
                "RabbitMQ": "Lettermint\\RabbitMQ\\Facades\\RabbitMQ"
            }
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest --exclude-group=integration",
        "test-coverage": "vendor/bin/pest --coverage --exclude-group=integration",
        "test-integration": "vendor/bin/pest --group=integration",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
